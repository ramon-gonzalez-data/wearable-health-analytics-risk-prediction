# Gitignore
# Files and filename patterns that Git should ignore for this repository.

# Raw data files generated locally
data/raw/*.csv

# Intermediate CSV files used during data generation
# These files are required during local data generation, but are intermediate artifacts and are not version-controlled.
python/data_generation/devices_full.csv
python/data_generation/member_devices_full.csv
python/data_generation/members_full.csv

#Python cache files
__pycache__/
*.py[cod]
